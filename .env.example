# Indexing mode: "ai" uses Qwen as the primary retriever; "static" never
# invokes Ollama. An explicit mode wins over the legacy Qwen toggle below.
CHATCODE_INDEX_MODE=ai

# Optional local semantic-analysis model. Install it with:
#   ollama pull qwen2.5-coder:7b
CHATCODE_QWEN_MODEL=qwen2.5-coder:1.5b
# Backwards-compatible toggle used only when CHATCODE_INDEX_MODE is omitted.
CHATCODE_QWEN_ENABLED=true
